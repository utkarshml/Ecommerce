{
  "version": 2,
  "builds": [
    {
      "src": "api/Backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "options": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/v1/api/(.*)",
      "dest": "api/Backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/dist/index.html"
    }
  ]
}
